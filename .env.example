# OpenAI LLM 파일럿
# 실제 키는 이 파일이 아니라 Git에서 제외된 `.env`에만 입력합니다.
OPENAI_API_KEY=
# 생략하면 configs/llm.yaml의 gpt-5.6-luna를 사용합니다.
OPENAI_MODEL=gpt-5.6-luna

# 열린재정 OpenAPI 수집
OPEN_FISCAL_API_KEY=

# 결산 로컬 파일 경로(선택)
OPEN_FISCAL_SETTLEMENT_DIR=data/raw/settlement

# 단일 부처 수집 명령에서만 사용합니다(선택).
# 월별 지출운용상황(VWFOEM2)은 소관명이 아니라 소관코드가 필수입니다.
# 확인 전에는 비워 두고 probe-all에서 monthly_expenditure가 skipped 되는지 확인합니다.
OPEN_FISCAL_MINISTRY_CODE=

# OpenAPI 호출 설정
OPEN_FISCAL_TIMEOUT=30
OPEN_FISCAL_PAGE_SIZE=1000
OPEN_FISCAL_REQUEST_INTERVAL_SECONDS=0.4
